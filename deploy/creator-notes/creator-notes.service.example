[Unit]
Description=Atomic Creator Notes bounded Voice ingest
Documentation=file:///path/to/iamresist_v2/deploy/creator-notes/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CREATOR_NOTES_USER
Group=CREATOR_NOTES_GROUP
WorkingDirectory=/path/to/iamresist_v2
EnvironmentFile=/path/to/iamresist_v2/.env.local
ExecStart=/usr/bin/npm run creator-notes:podcast-batch -- --limit 10
Nice=10
TimeoutStartSec=14400
# Application lock in the CLI prevents overlapping npm runs.
# Optional extra host lock:
# ExecStart=/usr/bin/flock -n /run/creator-notes.lock /usr/bin/npm run creator-notes:podcast-batch -- --limit 10

[Install]
WantedBy=multi-user.target
