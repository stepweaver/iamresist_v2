# Atomic Creator Notes VPS / local batch environment
# Copy to the repository `.env.local` on the VPS. Do not commit real values.
# Creator Notes text inference is separate from Theme Memory and from transcription.

# Supabase (existing names — do not invent duplicates)
POSTGRES_SUPABASE_URL=
POSTGRES_SUPABASE_SERVICE_ROLE_KEY=
# Alternates also recognized: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Notion Voices discovery
NOTION_API_KEY=
NOTION_VOICES_DB_ID=

# Production Creator Notes text inference (Groq).
# CREATOR_NOTES_AI_PROVIDER selects groq or ollama.
# THEME_AI_PROVIDER does not need to be ollama when Groq is selected explicitly.
# If CREATOR_NOTES_AI_PROVIDER is unset and THEME_AI_PROVIDER=ollama, the legacy local Ollama path remains available.
CREATOR_NOTES_AI_PROVIDER=groq
CREATOR_NOTES_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY must exist in the runtime environment when the provider is groq.
# Never commit it. This example intentionally does not assign that variable.

# Inference timeout for the selected text provider (Groq or Ollama). Independent of Theme Memory.
CREATOR_NOTES_AI_TIMEOUT_MS=300000

# Production default is one evidence window per inference request.
# CREATOR_NOTES_WINDOW_BATCH_SIZE=1

# Local Ollama alternative. Not used when CREATOR_NOTES_AI_PROVIDER=groq.
# Groq failures, including HTTP 429, do not fall back to Ollama.
# Model order when the provider is ollama: CREATOR_NOTES_MODEL, then OLLAMA_MODEL, then gemma3:4b.
# THEME_AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# CREATOR_NOTES_OLLAMA_KEEP_ALIVE=5m
# Theme Memory Ollama settings, unused by Creator Notes Groq inference:
# THEME_AI_TIMEOUT_MS=45000
# THEME_AI_STARTUP_TIMEOUT_MS=180000
# THEME_AI_MAX_RETRIES=2

# Ranking must stay shadow; creator notes never write ranking state
THEME_RANKING_MODE=shadow

# Transcription is separate from text inference.
# CREATOR_NOTES_TRANSCRIPTION_PROVIDER selects the podcast audio fallback used by --transcribe-audio.
#   groq  — Groq speech-to-text (POST /openai/v1/audio/transcriptions)
#   local — existing faster-whisper subprocess (`whisper` is an alias)
# Unset selects local, so existing installs keep faster-whisper.
# A Groq transcription failure, including HTTP 429, does not fall back to local Whisper.
# CREATOR_NOTES_TRANSCRIPTION_MODEL applies only to Groq. Local keeps CREATOR_NOTES_WHISPER_MODEL.
# Direct Groq uploads must be 25 MB or smaller. Larger enclosures are split into gapless MP3 chunks.
# ffmpeg is required for that split, and for the local WAV transcode.
# GROQ_API_KEY is the same runtime key as text inference. Never commit it.
CREATOR_NOTES_TRANSCRIPTION_PROVIDER=groq
CREATOR_NOTES_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Local faster-whisper, used when CREATOR_NOTES_TRANSCRIPTION_PROVIDER=local or unset.
# Host prerequisites: ffmpeg on PATH, Python 3, and:
#   python3 -m pip install -r scripts/audio-transcription/requirements.txt
# Model default stays small. CREATOR_NOTES_TRANSCRIPTION_MODEL does not change this.
# CREATOR_NOTES_WHISPER_MODEL=small
# CREATOR_NOTES_TRANSCRIBE_LANGUAGE=en
# CREATOR_NOTES_PYTHON=python3
# CREATOR_NOTES_FFMPEG=ffmpeg

# Jev shadow evaluation. Read-only same-event decisions. Never commit the key.
# The model id is pinned in code to jev-1.13.0.
# TYPESAFE_API_KEY=

# Optional
# CREATOR_NOTES_LOCK_FILE=/run/creator-notes-batch.lock
