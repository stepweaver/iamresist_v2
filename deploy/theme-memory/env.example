# Theme Memory VPS / local batch environment
# Copy to the repository `.env.local` on the VPS. Do not commit real values.

# Supabase (existing names — do not invent duplicates)
POSTGRES_SUPABASE_URL=
POSTGRES_SUPABASE_SERVICE_ROLE_KEY=
# Alternates also recognized: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Notion Voices ingest
NOTION_API_KEY=
NOTION_VOICES_DB_ID=

# Theme Memory AI (process must run on the same host as Ollama)
THEME_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
THEME_AI_TIMEOUT_MS=45000
THEME_AI_MAX_RETRIES=2

# Ranking must stay shadow until a later calibration says otherwise
THEME_RANKING_MODE=shadow

# Optional
# THEME_MEMORY_LOCK_FILE=/run/theme-memory-daily.lock
# INTERNAL_THEME_RANKING_DEBUG=1
