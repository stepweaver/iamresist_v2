{
  "name": "iamresist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "typecheck": "tsc --noEmit",
    "theme-memory:daily": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/theme-memory-daily.ts",
    "theme-memory:ai-check": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/theme-memory-ai-check.ts",
    "theme-memory:reclassify": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/theme-memory-reclassify.ts",
    "theme-memory:ranking-coverage": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/theme-memory-ranking-coverage.ts",
    "creator-notes:extract": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-extract.ts",
    "creator-notes:sources": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-sources.ts",
    "creator-notes:batch": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-batch.ts",
    "creator-notes:review": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-review.ts",
    "creator-notes:podcast-sources": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-podcast-sources.ts",
    "creator-notes:podcast-feeds": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-podcast-feeds.ts",
    "creator-notes:extract-podcast": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-extract-podcast.ts",
    "creator-notes:podcast-batch": "node --require ./scripts/theme-memory-preload.cjs --import tsx scripts/creator-notes-podcast-batch.ts"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@supabase/supabase-js": "^2.102.1",
    "lucide-react": "^0.460.0",
    "next": "15.5.14",
    "p-limit": "^7.2.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "stripe": "^20.4.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "19.2.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.14",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
